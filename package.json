{
  "name": "nova-render-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "shaders:webgpu": "node scripts/webgpu/generate.mjs",
    "predocs:dev": "npm run shaders:webgpu",
    "predocs:build": "npm run shaders:webgpu",
    "check:webgpu": "node scripts/webgpu/check.mjs",
    "format:web": "prettier --write web scripts/webgpu docs/.vitepress",
    "check:format:web": "prettier --check web scripts/webgpu docs/.vitepress",
    "pack:sdk": "node scripts/packaging/sdk.mjs",
    "pack:web": "node scripts/packaging/web.mjs"
  },
  "devDependencies": {
    "naga-wasi-cli": "0.1.0",
    "playwright": "1.65.0",
    "prettier": "3.6.2",
    "shiki": "2.5.0",
    "vitepress": "1.6.4"
  }
}
