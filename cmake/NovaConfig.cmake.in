@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_nova_consumer_system "${CMAKE_SYSTEM_NAME}")
if(CMAKE_SYSTEM_NAME STREQUAL "iOS" AND CMAKE_OSX_SYSROOT MATCHES "[Ii][Pp]hone[Ss]imulator")
    set(_nova_consumer_system "iOS-Simulator")
endif()
if(NOT _nova_consumer_system STREQUAL "@nova_sdk_system@")
    set(Nova_FOUND FALSE)
    set(Nova_NOT_FOUND_MESSAGE "This Nova SDK targets @nova_sdk_system@, but the consumer targets ${_nova_consumer_system}.")
    return()
endif()
set(Nova_WINDOW_HOST_CONTROLS TRUE)
set(Nova_GLTF_FILE_LOADING @NOVA_ENABLE_GLTF@)
# Search bundled dependencies first, while allowing conventional external packages.
find_dependency(SDL3 CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/sdl3")
if(@NOVA_SDK_NEEDS_VOLK@)
    if(NOT DEFINED VOLK_PULL_IN_VULKAN)
        set(VOLK_PULL_IN_VULKAN OFF) # volk loads the system Vulkan loader at runtime.
    endif()
    find_dependency(volk CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/volk")
endif()
if(@NOVA_ENABLE_UI@)
    find_dependency(imgui CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/imgui")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NovaTargets.cmake")
check_required_components(Nova)
