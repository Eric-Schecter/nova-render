@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
# Search bundled dependencies first, while allowing conventional external packages.
if(@NOVA_ENABLE_SDL3@)
    find_dependency(SDL3 CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/sdl3")
endif()
find_dependency(glfw3 CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/glfw3")
if(@NOVA_SDK_NEEDS_VOLK@)
    if(NOT DEFINED VOLK_PULL_IN_VULKAN)
        set(VOLK_PULL_IN_VULKAN OFF) # volk loads the system Vulkan loader at runtime.
    endif()
    find_dependency(volk CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/volk")
endif()
if(@NOVA_ENABLE_UI@)
    find_dependency(imgui CONFIG HINTS "${PACKAGE_PREFIX_DIR}/share/imgui")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NovaTargets.cmake")
check_required_components(Nova)
