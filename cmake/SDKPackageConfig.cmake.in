set(_configuration "${CPACK_BUILD_CONFIG}")
if(NOT _configuration)
    set(_configuration "@CMAKE_BUILD_TYPE@")
endif()
if(NOT _configuration)
    message(FATAL_ERROR "Choose a configuration with cpack -C Debug or Release")
endif()
string(TOLOWER "nova-render-sdk-@PROJECT_VERSION@-@nova_sdk_system@-@nova_sdk_arch@-@CMAKE_CXX_COMPILER_ID@-${_configuration}" CPACK_PACKAGE_FILE_NAME)
