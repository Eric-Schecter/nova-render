include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
option(NOVA_BUNDLE_DEPENDENCIES "Include vcpkg GLFW/volk/optional ImGui files in the install prefix" ON)
install(TARGETS nova_render EXPORT NovaTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
install(DIRECTORY render/include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
install(EXPORT NovaTargets NAMESPACE Nova:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Nova)
set(NOVA_SDK_NEEDS_VOLK ${NOVA_ENABLE_VULKAN})
if(TARGET volk::volk)
    set(NOVA_SDK_NEEDS_VOLK ON)
endif()
configure_package_config_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/NovaConfig.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/NovaConfig.cmake" INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Nova)
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/NovaConfigVersion.cmake"
    VERSION ${PROJECT_VERSION} COMPATIBILITY SameMinorVersion)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/NovaConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/NovaConfigVersion.cmake"
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Nova)
if(NOVA_BUNDLE_DEPENDENCIES)
    if(NOT VCPKG_INSTALLED_DIR OR NOT VCPKG_TARGET_TRIPLET)
        message(FATAL_ERROR "Bundling requires vcpkg. Set NOVA_BUNDLE_DEPENDENCIES=OFF to use externally managed dependencies.")
    endif()
    set(dep_prefix "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}")
    foreach(header_dep tinygltf glm stb nlohmann-json)
        install(FILES "${dep_prefix}/share/${header_dep}/copyright" DESTINATION "share/Nova/licenses/${header_dep}")
    endforeach()
    set(dep_packages)
    if(NOVA_ENABLE_GLFW)
        list(APPEND dep_packages glfw3)
        install(DIRECTORY "${dep_prefix}/include/GLFW" DESTINATION include)
    endif()
    if(NOVA_ENABLE_SDL3)
        list(APPEND dep_packages sdl3)
        install(DIRECTORY "${dep_prefix}/include/SDL3" DESTINATION include)
    endif()
    if(NOVA_SDK_NEEDS_VOLK)
        list(APPEND dep_packages volk vulkan-headers)
    endif()
    if(NOVA_ENABLE_UI)
        list(APPEND dep_packages imgui)
        install(FILES "${dep_prefix}/include/imgui.h" "${dep_prefix}/include/imconfig.h" DESTINATION include)
    endif()
    foreach(package IN LISTS dep_packages)
        install(DIRECTORY "${dep_prefix}/share/${package}/" DESTINATION "share/${package}")
    endforeach()
    if(NOVA_SDK_NEEDS_VOLK)
        install(FILES "${dep_prefix}/include/volk.h" DESTINATION include)
        install(DIRECTORY "${dep_prefix}/include/vulkan" "${dep_prefix}/include/vk_video" DESTINATION include)
    endif()
    # Preserve vcpkg's Debug/Release layout, including DLLs for dynamic triplets.
    set(glfw_artifacts "__nova_no_glfw__")
    if(NOVA_ENABLE_GLFW)
        set(glfw_artifacts "*glfw*")
    endif()
    foreach(folder lib debug/lib bin debug/bin)
        install(DIRECTORY "${dep_prefix}/${folder}/" DESTINATION "${folder}" OPTIONAL
            FILES_MATCHING PATTERN "${glfw_artifacts}" PATTERN "*SDL3*" PATTERN "*sdl3*" PATTERN "*volk*" PATTERN "*imgui*" PATTERN "pkgconfig" EXCLUDE)
    endforeach()
endif()

install(FILES "${PROJECT_SOURCE_DIR}/render/shaders/third_party/smaa/LICENSE.txt"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/nova/licenses" RENAME SMAA-LICENSE.txt)
install(FILES "${PROJECT_SOURCE_DIR}/render/shaders/third_party/fxaa/NOTICE.txt"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/nova/licenses" RENAME FXAA-NOTICE.txt)

include("${CMAKE_CURRENT_LIST_DIR}/SDKPackage.cmake")

# Embed source provenance in the install prefix so paired native/Web archives can be audited.
execute_process(COMMAND git -C "${PROJECT_SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE nova_source_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${PROJECT_SOURCE_DIR}" diff --quiet RESULT_VARIABLE nova_source_diff ERROR_QUIET)
set(nova_source_dirty false)
if(NOT nova_source_diff EQUAL 0)
    set(nova_source_dirty true)
endif()
set(nova_ui_enabled false)
if(NOVA_ENABLE_UI)
    set(nova_ui_enabled true)
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/nova-build-info.json"
    "{\n  \"version\": \"${PROJECT_VERSION}\",\n  \"sourceCommit\": \"${nova_source_commit}\",\n  \"sourceDirty\": ${nova_source_dirty},\n  \"uiEnabled\": ${nova_ui_enabled},\n  \"platform\": \"${CMAKE_SYSTEM_NAME}\",\n  \"architecture\": \"${CMAKE_SYSTEM_PROCESSOR}\",\n  \"configuration\": \"${CMAKE_BUILD_TYPE}\",\n  \"features\": [\"static-scenes\",\"camera-viewport\",\"scene-picking\",\"material-slots\",\"scene-bvh-shadows\",\"raster-fog\",\"environment-clear\",\"application-ui\",\"scene-lights\",\"ray-scene-instances\",\"ray-scene-lights\",\"ray-local-source-emission\",\"material-alpha\",\"weighted-oit\",\"model-deferred\",\"hybrid-rendering\",\"scene-animation\",\"scene-animation-queries\",\"scene-animation-shadows\",\"single-animation-shadows\"]\n}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/nova-build-info.json" DESTINATION "share/nova-render" RENAME build-info.json)
