option(NOVA_ENABLE_PATH_TRACING "Build the native progressive path tracer" ON)
if(NOT NOVA_ENABLE_PATH_TRACING)
    return()
endif()
foreach(_kernel IN ITEMS pathtrace denoise photon-clear photon-trace mlt-bootstrap mlt-reduce mlt-mutate ao-prepare ao-pyramid ao-main ao-filter)
    if(_kernel MATCHES "^ao-")
        if(_kernel STREQUAL "ao-prepare")
            set(_entry AOPrepare)
            set(_path_defines)
        elseif(_kernel STREQUAL "ao-pyramid")
            set(_entry AOPyramid)
            set(_path_defines -DNOVA_DENOISE_ONLY=1)
        elseif(_kernel STREQUAL "ao-filter")
            set(_entry AOFilter)
            set(_path_defines -DNOVA_DENOISE_ONLY=1)
        else()
            set(_entry AOMain)
            set(_path_defines)
        endif()
    elseif(_kernel STREQUAL "pathtrace")
        set(_entry CSMain)
        set(_path_defines)
    elseif(_kernel STREQUAL "mlt-bootstrap")
        set(_entry MLTBootstrap)
        set(_path_defines)
    elseif(_kernel STREQUAL "mlt-reduce")
        set(_entry MLTReduce)
        set(_path_defines -DNOVA_DENOISE_ONLY=1)
    elseif(_kernel STREQUAL "mlt-mutate")
        set(_entry MLTMutate)
        set(_path_defines)
    elseif(_kernel STREQUAL "photon-trace")
        set(_entry PhotonMain)
        set(_path_defines)
    elseif(_kernel STREQUAL "photon-clear")
        set(_entry PhotonClear)
        set(_path_defines -DNOVA_DENOISE_ONLY=1)
    else()
        set(_entry DenoiseMain)
        set(_path_defines -DNOVA_DENOISE_ONLY=1)
    endif()
    set(_path_source "${PROJECT_SOURCE_DIR}/render/shaders/pathtrace.hlsl")
    if(_kernel MATCHES "^ao-")
        set(_path_source "${PROJECT_SOURCE_DIR}/render/shaders/ambient-occlusion.hlsl")
    endif()
    if(NOVA_ENABLE_VULKAN OR APPLE)
        set(_path_spv "${SHADER_OUTPUT_DIR}/${_kernel}.compute.spv")
        add_custom_command(OUTPUT "${_path_spv}"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${SHADER_OUTPUT_DIR}"
            COMMAND "${NOVA_DXC_EXECUTABLE}" -spirv -fspv-target-env=vulkan1.2 -T cs_6_5 -E ${_entry} ${_path_defines} "${_path_source}" -Fo "${_path_spv}"
            DEPENDS "${_path_source}" "${PROJECT_SOURCE_DIR}/render/shaders/pathtrace.hlsl" "${NOVA_DXC_EXECUTABLE}" VERBATIM)
        if(NOVA_ENABLE_VULKAN)
            list(APPEND SHADER_OUTPUTS "${_path_spv}")
        endif()
    endif()
    if(APPLE)
        set(_path_metal "${SHADER_OUTPUT_DIR}/${_kernel}.metallib")
        add_custom_command(OUTPUT "${_path_metal}"
            COMMAND "${NOVA_SPIRV_CROSS_EXECUTABLE}" "${_path_spv}" --msl --msl-version 30000 --msl-decoration-binding --output "${SHADER_OUTPUT_DIR}/${_kernel}.metal"
            COMMAND "${NOVA_XCRUN_EXECUTABLE}" -sdk macosx metal -std=metal3.0 -c "${SHADER_OUTPUT_DIR}/${_kernel}.metal" -o "${SHADER_OUTPUT_DIR}/${_kernel}.air"
            COMMAND "${NOVA_XCRUN_EXECUTABLE}" -sdk macosx metallib "${SHADER_OUTPUT_DIR}/${_kernel}.air" -o "${_path_metal}"
            DEPENDS "${_path_spv}" "${NOVA_SPIRV_CROSS_EXECUTABLE}" VERBATIM)
        list(APPEND SHADER_OUTPUTS "${_path_metal}")
    elseif(WIN32)
        set(_path_dxil "${SHADER_OUTPUT_DIR}/${_kernel}.compute.dxil")
        add_custom_command(OUTPUT "${_path_dxil}"
            COMMAND ${CMAKE_COMMAND} -E make_directory "${SHADER_OUTPUT_DIR}"
            COMMAND "${NOVA_DXC_EXECUTABLE}" -T cs_6_5 -E ${_entry} ${_path_defines} "${_path_source}" -Fo "${_path_dxil}"
            DEPENDS "${_path_source}" "${PROJECT_SOURCE_DIR}/render/shaders/pathtrace.hlsl" "${NOVA_DXC_EXECUTABLE}" VERBATIM)
        list(APPEND SHADER_OUTPUTS "${_path_dxil}")
    endif()
    list(APPEND _all_path_outputs ${_path_spv} ${_path_metal} ${_path_dxil})
endforeach()
add_custom_target(nova_path_shaders DEPENDS ${_all_path_outputs})
