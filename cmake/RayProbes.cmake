option(NOVA_BUILD_RAY_PROBES "Build experimental ray-query feasibility probes" OFF)
if(NOT NOVA_BUILD_RAY_PROBES)
    return()
endif()
set(ray_source "${PROJECT_SOURCE_DIR}/tools/ray_probe/query.hlsl")
set(ray_dir "${CMAKE_CURRENT_BINARY_DIR}/ray-probe")
file(MAKE_DIRECTORY "${ray_dir}")
add_custom_command(OUTPUT "${ray_dir}/query.dxil"
    COMMAND "${NOVA_DXC_EXECUTABLE}" -T cs_6_5 -E CSMain "${ray_source}" -Fo "${ray_dir}/query.dxil"
    DEPENDS "${ray_source}" "${NOVA_DXC_EXECUTABLE}" VERBATIM)
add_custom_command(OUTPUT "${ray_dir}/query.spv"
    COMMAND "${NOVA_DXC_EXECUTABLE}" -spirv -fspv-target-env=vulkan1.2 -T cs_6_5 -E CSMain "${ray_source}" -Fo "${ray_dir}/query.spv"
    DEPENDS "${ray_source}" "${NOVA_DXC_EXECUTABLE}" VERBATIM)
add_custom_target(nova_ray_query_shaders ALL DEPENDS "${ray_dir}/query.dxil" "${ray_dir}/query.spv")
if(APPLE)
    add_custom_command(OUTPUT "${ray_dir}/query.metallib"
        COMMAND "${NOVA_SPIRV_CROSS_EXECUTABLE}" "${ray_dir}/query.spv" --msl --msl-version 30000 --msl-decoration-binding --output "${ray_dir}/query.metal"
        COMMAND "${NOVA_XCRUN_EXECUTABLE}" -sdk macosx metal -std=metal3.0 -c "${ray_dir}/query.metal" -o "${ray_dir}/query.air"
        COMMAND "${NOVA_XCRUN_EXECUTABLE}" -sdk macosx metallib "${ray_dir}/query.air" -o "${ray_dir}/query.metallib"
        DEPENDS "${ray_dir}/query.spv" "${NOVA_SPIRV_CROSS_EXECUTABLE}" VERBATIM)
    add_executable(nova_ray_probe_metal tools/ray_probe/Metal.mm "${ray_dir}/query.metallib")
    set_source_files_properties(tools/ray_probe/Metal.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    add_dependencies(nova_ray_probe_metal nova_ray_query_shaders)
    target_link_libraries(nova_ray_probe_metal PRIVATE "-framework Metal" "-framework Foundation")
    add_test(NAME ray-query-metal COMMAND nova_ray_probe_metal "${ray_dir}/query.metallib")
    set_tests_properties(ray-query-metal PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 30)
endif()
if(WIN32)
    add_executable(nova_ray_probe_dx12 tools/ray_probe/D3D12.cpp)
    target_compile_definitions(nova_ray_probe_dx12 PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(nova_ray_probe_dx12 PRIVATE d3d12 dxgi)
    add_dependencies(nova_ray_probe_dx12 nova_ray_query_shaders)
    foreach(mode hardware warp)
        set(ray_args)
        if(mode STREQUAL "warp")
            set(ray_args --warp)
        endif()
        add_test(NAME ray-query-dx12-${mode} COMMAND nova_ray_probe_dx12 "${ray_dir}/query.dxil" ${ray_args})
        set_tests_properties(ray-query-dx12-${mode} PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 30)
    endforeach()
endif()
if(NOVA_ENABLE_VULKAN)
    add_executable(nova_ray_probe_vulkan tools/ray_probe/Vulkan.cpp)
    target_link_libraries(nova_ray_probe_vulkan PRIVATE volk::volk)
    target_compile_definitions(nova_ray_probe_vulkan PRIVATE VK_NO_PROTOTYPES)
    add_dependencies(nova_ray_probe_vulkan nova_ray_query_shaders)
    add_test(NAME ray-query-vulkan COMMAND nova_ray_probe_vulkan "${ray_dir}/query.spv")
    set_tests_properties(ray-query-vulkan PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 30)
endif()
