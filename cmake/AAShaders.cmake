# Independent raster AA shaders. No ray-query requirement.
foreach(pass RANGE 0 29)
    set(aa_air)
    if(pass EQUAL 25 OR pass EQUAL 26)
        set(stages comp)
    else()
        set(stages vert frag)
    endif()
    foreach(stage IN LISTS stages)
        if(stage STREQUAL "vert")
            set(entry VSMain)
            set(profile vs_6_0)
            set(invert -fvk-invert-y)
        elseif(stage STREQUAL "comp")
            set(entry PipelineCSMain)
            set(profile cs_6_0)
            set(invert)
        else()
            set(entry PSMain)
            set(profile ps_6_0)
            set(invert)
        endif()
        set(base "${SHADER_OUTPUT_DIR}/aa-${pass}.${stage}")
        set(source "${PROJECT_SOURCE_DIR}/render/shaders/antialiasing.hlsl")
        if(pass GREATER_EQUAL 9)
            set(source "${PROJECT_SOURCE_DIR}/render/shaders/shadows.hlsl")
        endif()
        if(pass GREATER_EQUAL 11)
            set(source "${PROJECT_SOURCE_DIR}/render/shaders/postprocessing.hlsl")
        endif()
        if(pass GREATER_EQUAL 17)
            set(source "${PROJECT_SOURCE_DIR}/render/shaders/ssr.hlsl")
        endif()
        if(pass GREATER_EQUAL 22)
            set(source "${PROJECT_SOURCE_DIR}/render/shaders/pipelines.hlsl")
        endif()
        if(pass EQUAL 29)
            set(source "${PROJECT_SOURCE_DIR}/render/shaders/transparency.hlsl")
        endif()
        set(dependencies "${source}" "${PROJECT_SOURCE_DIR}/render/shaders/probe-scene.hlsli" "${PROJECT_SOURCE_DIR}/render/shaders/texture-filtering.hlsli" "${PROJECT_SOURCE_DIR}/render/shaders/third_party/fxaa/FXAA.hlsli" "${PROJECT_SOURCE_DIR}/render/shaders/third_party/smaa/SMAA.hlsl")
        if(NOVA_ENABLE_VULKAN)
            add_custom_command(OUTPUT "${base}.spv"
                COMMAND "${NOVA_DXC_EXECUTABLE}" -spirv -fspv-target-env=vulkan1.0 ${invert} -DAA_PASS=${pass} -T ${profile} -E ${entry} "${source}" -Fo "${base}.spv"
                DEPENDS ${dependencies} VERBATIM)
            list(APPEND SHADER_OUTPUTS "${base}.spv")
        endif()
        if(APPLE)
            add_custom_command(OUTPUT "${base}.air"
                COMMAND "${NOVA_DXC_EXECUTABLE}" -spirv -fspv-target-env=vulkan1.0 -DAA_PASS=${pass} -T ${profile} -E ${entry} "${source}" -Fo "${base}.metal.spv"
                COMMAND "${NOVA_SPIRV_CROSS_EXECUTABLE}" "${base}.metal.spv" --msl --msl-version 20100 --msl-decoration-binding --output "${base}.metal"
                COMMAND "${NOVA_XCRUN_EXECUTABLE}" -sdk macosx metal -std=macos-metal2.1 -c "${base}.metal" -o "${base}.air"
                DEPENDS ${dependencies} VERBATIM)
            list(APPEND aa_air "${base}.air")
        elseif(WIN32)
            add_custom_command(OUTPUT "${base}.dxil"
                COMMAND "${NOVA_DXC_EXECUTABLE}" -DAA_PASS=${pass} -T ${profile} -E ${entry} "${source}" -Fo "${base}.dxil"
                DEPENDS ${dependencies} VERBATIM)
            list(APPEND SHADER_OUTPUTS "${base}.dxil")
        endif()
    endforeach()
    if(APPLE)
        set(output "${SHADER_OUTPUT_DIR}/aa-${pass}.metallib")
        add_custom_command(OUTPUT "${output}"
            COMMAND "${NOVA_XCRUN_EXECUTABLE}" -sdk macosx metallib ${aa_air} -o "${output}"
            DEPENDS ${aa_air} VERBATIM)
        list(APPEND SHADER_OUTPUTS "${output}")
    endif()
endforeach()
