if(NOT DEFINED EXE OR NOT DEFINED EXPECT)
    message(FATAL_ERROR "EXE and EXPECT are required")
endif()
execute_process(COMMAND "${EXE}" ${ARGS}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
set(log "${out}${err}")
message("${log}")
if(NOT "${result}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Process failed or timed out: ${result}")
endif()
if(FAILURE_EXPECTED)
    if(result EQUAL 0 OR NOT log MATCHES "${EXPECT}")
        message(FATAL_ERROR "Expected rejection '${EXPECT}', got ${result}")
    endif()
    if(ALLOW_SELECTION)
        if(NOT log MATCHES "Selected backend: ${SELECTION} ")
            message(FATAL_ERROR "Initialization failure did not select the requested backend")
        endif()
        foreach(other Vulkan Metal D3D12)
            if(NOT other STREQUAL SELECTION AND log MATCHES "(Selected backend: |Backend: )${other}")
                message(FATAL_ERROR "Initialization failure attempted another backend: ${other}")
            endif()
        endforeach()
    elseif(log MATCHES "Selected backend:")
        message(FATAL_ERROR "Rejected request reached device initialization")
    endif()
else()
    if(NOT result EQUAL 0 OR NOT log MATCHES "Backend: ${EXPECT}([\r\n]|$)"
       OR NOT log MATCHES "Rendered 120 frames; validation errors: 0"
       OR NOT log MATCHES "Window resize check passed")
        message(FATAL_ERROR "Backend/frame/resize validation failed: ${result}")
    endif()
endif()
