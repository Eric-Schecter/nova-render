{
  "name": "nova-render",
  "version-string": "0.10.13",
  "builtin-baseline": "971828fe0920d00c077c7b5d34798bc45b261ec4",
  "dependencies": [
    {
      "name": "directx-dxc",
      "host": true,
      "platform": "windows | (linux & x64)"
    },
    {
      "name": "spirv-cross",
      "host": true,
      "platform": "osx"
    },
    "tinygltf",
    "glm",
    "sdl3"
  ],
  "default-features": [
    "vulkan"
  ],
  "features": {
    "vulkan": {
      "description": "Vulkan backend",
      "dependencies": [
        "volk",
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        }
      ]
    },
    "ui": {
      "description": "Optional parameter UI",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "sdl3-binding"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "metal-binding"
          ],
          "platform": "osx"
        },
        {
          "name": "imgui",
          "features": [
            "dx12-binding"
          ],
          "platform": "windows"
        }
      ]
    },
    "ui-vulkan": {
      "description": "ImGui Vulkan binding with volk",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "vulkan-binding"
          ]
        }
      ]
    }
  },
  "vcpkg-configuration": {
    "overlay-ports": [
      "./ports"
    ]
  },
  "description": "Nova Render cross-platform rendering library"
}
