{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (vcpkg)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows ARM64 MSVC (CLion / Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows-vulkan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "NOVA_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "windows-dx12",
      "displayName": "Windows DX12 only (CLion / Ninja)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "NOVA_ENABLE_VULKAN": "OFF"
      },
      "binaryDir": "${sourceDir}/build-windows"
    },
    {
      "name": "linux-vulkan",
      "displayName": "Linux Vulkan (vcpkg / Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "NOVA_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 MSVC (CLion / Ninja)",
      "inherits": "windows-msvc",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build-windows-x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "windows-dx12",
      "configurePreset": "windows-dx12"
    },
    {
      "name": "linux-vulkan",
      "configurePreset": "linux-vulkan"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64"
    }
  ]
}
